From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Martins <eduardo@martins.ws>
Date: Tue, 3 Nov 2026 21:00:00 -0600
Subject: [PATCH] wifi: brcmfmac: pcie: Add the Apple BCM4357 device
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The iPhone X (d221) radio enumerates as 14e4:440a, the Apple BCM4357.
brcmfmac does not know the device ID, so no driver binds even though the
firmware and NVRAM are already installed under
brcmfmac4357-pcie.apple,herculesk.*. It is a mobility chip like the
neighbouring 4356/4358/4359, so it uses the WCC firmware framework.
Its TCM RAM is at 0x170000, not the 0x180000 of the 435x chips: the
d221 firmware (4357b1, 13.10.688.4) is linked there, and 652 of its 697
string pointers resolve only with that base. Loading it 64 KiB too high
puts the NVRAM past the end of RAM.

It is an Apple "olympic" firmware with bcm_rng, like the 4355, 4364 and
4377 ones, so it gets the random seed before the NVRAM too (WCC_SEED).

Apple ships one NVRAM per module vendor and version
(apple,herculesk-GINS-m-5.3, apple,herculesk-GINS-u-6.1), chosen by the
record in the radio's OTP. The BCM4357 has an always-on backplane, with
GCI and PMU cores of their own like the BCM4377 family, so its
ChipCommon reports no OTP size (an iPhone X read none) and the OTP is
shadowed in the GCI core from 0x1000. Where Apple's record starts in it
isn't known, so read its first KiB and look for the system-vendor tuple;
without one, keep the board-type names.

Add the 4357 chip and device IDs, wire its firmware name as WCC with the
seed, give it the TCM RAM base its firmware is linked at, and read its OTP.

Assisted-by: LLM
---
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/chip.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/chip.c
index 2da91347c..68a98d239 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/chip.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/chip.c
@@ -742,6 +742,7 @@ static u32 brcmf_chip_tcm_rambase(struct brcmf_chip_priv *ci)
 	case BRCM_CC_43751_CHIP_ID:
 	case BRCM_CC_43752_CHIP_ID:
 	case BRCM_CC_4377_CHIP_ID:
+	case BRCM_CC_4357_CHIP_ID:
 		return 0x170000;
 	case BRCM_CC_4378_CHIP_ID:
 		return 0x352000;
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index 7167dc8b0..a8f419e87 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -57,6 +57,7 @@ BRCMF_FW_DEF(4350C, "brcmfmac4350c2-pcie");
 BRCMF_FW_CLM_DEF(4355, "brcmfmac4355-pcie");
 BRCMF_FW_CLM_DEF(4355C1, "brcmfmac4355c1-pcie");
 BRCMF_FW_CLM_DEF(4356, "brcmfmac4356-pcie");
+BRCMF_FW_DEF(4357, "brcmfmac4357-pcie");
 BRCMF_FW_CLM_DEF(43570, "brcmfmac43570-pcie");
 BRCMF_FW_DEF(4358, "brcmfmac4358-pcie");
 BRCMF_FW_DEF(4359, "brcmfmac4359-pcie");
@@ -95,6 +96,7 @@ static const struct brcmf_firmware_mapping brcmf_pcie_fwnames[] = {
 	BRCMF_FW_ENTRY(BRCM_CC_4355_CHIP_ID, 0x00002000, 54591),
 	BRCMF_FW_ENTRY(BRCM_CC_4355_CHIP_ID, 0xFFFFF800, 4355C1), /* rev ID 12/C2 seen */
 	BRCMF_FW_ENTRY(BRCM_CC_4356_CHIP_ID, 0xFFFFFFFF, 4356),
+	BRCMF_FW_ENTRY(BRCM_CC_4357_CHIP_ID, 0xFFFFFFFF, 4357),
 	BRCMF_FW_ENTRY(BRCM_CC_43567_CHIP_ID, 0xFFFFFFFF, 43570),
 	BRCMF_FW_ENTRY(BRCM_CC_43569_CHIP_ID, 0xFFFFFFFF, 43570),
 	BRCMF_FW_ENTRY(BRCM_CC_43570_CHIP_ID, 0xFFFFFFFF, 43570),
@@ -2087,7 +2089,8 @@ static int brcmf_pcie_read_otp(struct brcmf_pciedev_info *devinfo)
 	const struct pci_dev *pdev = devinfo->pdev;
 	struct brcmf_bus *bus = dev_get_drvdata(&pdev->dev);
 	u32 coreid, base, words, idx, sromctl, otpsize;
-	bool optional = false;
+	bool optional = false, scan = false;
+	size_t start = 0;
 	u16 *otp;
 	struct brcmf_core *core;
 	int ret;
@@ -2121,6 +2124,20 @@ static int brcmf_pcie_read_otp(struct brcmf_pciedev_info *devinfo)
 		words = (otpsize + 1) * 1024 / 16 - (0x8c0 - 0x800) / 2;
 		optional = true;
 		break;
+	case BRCM_CC_4357_CHIP_ID:
+		/*
+		 * The BCM4357 has an always-on backplane (separate GCI and
+		 * PMU cores) like the BCM4377 family, so ChipCommon reports no
+		 * OTP size and the OTP is shadowed in the GCI core from
+		 * 0x1000. Where Apple's records start in it isn't known, so
+		 * read its first KiB and look for the system-vendor tuple.
+		 */
+		coreid = BCMA_CORE_GCI;
+		base = 0x1000;
+		words = 0x200;
+		optional = true;
+		scan = true;
+		break;
 	case BRCM_CC_4355_CHIP_ID:
 		coreid = BCMA_CORE_CHIPCOMMON;
 		base = 0x8c0;
@@ -2190,7 +2207,25 @@ static int brcmf_pcie_read_otp(struct brcmf_pciedev_info *devinfo)
 		WRITECC32(devinfo, sromcontrol, sromctl);
 	}
 
-	ret = brcmf_pcie_parse_otp(devinfo, (u8 *)otp, 2 * words);
+	if (scan) {
+		const u8 *bytes = (const u8 *)otp;
+
+		/* Apple's record: type 0x15, length, then a 0x8 header */
+		for (start = 0; start + 6 <= 2 * words; start += 2)
+			if (bytes[start] == BRCMF_OTP_SYS_VENDOR &&
+			    get_unaligned_le32(&bytes[start + 2]) ==
+			    BRCMF_OTP_VENDOR_HDR)
+				break;
+		if (start + 6 > 2 * words) {
+			brcmf_dbg(PCIE, "No Apple OTP record, using default firmware\n");
+			kfree(otp);
+			return 0;
+		}
+		brcmf_dbg(PCIE, "Apple OTP record at 0x%zx\n", start);
+	}
+
+	ret = brcmf_pcie_parse_otp(devinfo, (u8 *)otp + start,
+				   2 * words - start);
 	kfree(otp);
 
 	if (ret && optional) {
@@ -2829,6 +2864,7 @@ static const struct pci_device_id brcmf_pcie_devid_table[] = {
 	BRCMF_PCIE_DEVICE(BRCM_PCIE_4354_RAW_DEVICE_ID, WCC),
 	BRCMF_PCIE_DEVICE(BRCM_PCIE_4355_DEVICE_ID, WCC_SEED),
 	BRCMF_PCIE_DEVICE(BRCM_PCIE_4356_DEVICE_ID, WCC),
+	BRCMF_PCIE_DEVICE(BRCM_PCIE_4357_DEVICE_ID, WCC_SEED),
 	BRCMF_PCIE_DEVICE(BRCM_PCIE_43567_DEVICE_ID, WCC),
 	BRCMF_PCIE_DEVICE(BRCM_PCIE_43570_DEVICE_ID, WCC),
 	BRCMF_PCIE_DEVICE(BRCM_PCIE_43570_RAW_DEVICE_ID, WCC),
diff --git a/drivers/net/wireless/broadcom/brcm80211/include/brcm_hw_ids.h b/drivers/net/wireless/broadcom/brcm80211/include/brcm_hw_ids.h
index f88899005..11534acaf 100644
--- a/drivers/net/wireless/broadcom/brcm80211/include/brcm_hw_ids.h
+++ b/drivers/net/wireless/broadcom/brcm80211/include/brcm_hw_ids.h
@@ -39,6 +39,7 @@
 #define BRCM_CC_4354_CHIP_ID		0x4354
 #define BRCM_CC_4355_CHIP_ID		0x4355
 #define BRCM_CC_4356_CHIP_ID		0x4356
+#define BRCM_CC_4357_CHIP_ID		0x4357
 #define BRCM_CC_43566_CHIP_ID		43566
 #define BRCM_CC_43567_CHIP_ID		43567
 #define BRCM_CC_43569_CHIP_ID		43569
@@ -83,6 +84,7 @@
 #define BRCM_PCIE_43570_RAW_DEVICE_ID	0xaa31
 #define BRCM_PCIE_4358_DEVICE_ID	0x43e9
 #define BRCM_PCIE_4359_DEVICE_ID	0x43ef
+#define BRCM_PCIE_4357_DEVICE_ID	0x440a
 #define BRCM_PCIE_43602_DEVICE_ID	0x43ba
 #define BRCM_PCIE_43602_2G_DEVICE_ID	0x43bb
 #define BRCM_PCIE_43602_5G_DEVICE_ID	0x43bc
-- 
2.35.1
